# Copy to .env and fill in. Never commit .env.

# --- External Postgres (runs as a separate service, outside this container) ---
# Plain libpq-style URL; the app converts it for SQLAlchemy/psycopg itself.
DATABASE_URL=postgresql://deep_agents:change-me@postgres.internal:5432/deep_agents
# Schema owned by this app (created on startup). Keeps tables apart from other apps.
DATABASE_SCHEMA=deep_agents
# Run Alembic migrations on startup (safe with several replicas: guarded by an advisory lock).
AUTO_MIGRATE=true

# --- LiteLLM gateway (OpenAI-compatible /v1 endpoint) ---
LLM_GATEWAY_URL=http://litellm.internal:4000/v1
# LiteLLM virtual key. Server-side only: never sent to the browser or written to logs.
LLM_API_KEY=sk-change-me
# Model alias exactly as configured in the gateway (agents may override it per run).
DEFAULT_MODEL=gpt-4o
# Extra OpenAI-compatible request parameters as JSON, e.g. {"parallel_tool_calls": false}
LLM_PARAMS_JSON={}
LLM_TIMEOUT_SECONDS=60
# Retries of one model request, only before the response starts. 0 disables.
LLM_MAX_RETRIES=1

# --- App behaviour ---
# Language of the system prompt and user-facing messages: en | hu (see src/deep_agents_app/prompts)
APP_LANGUAGE=en
DATA_DIR=/data
MAX_CONCURRENT_RUNS=3
RUN_TIMEOUT_SECONDS=3600
# process = every run in its own killable worker process (cancel/timeout kill it hard).
# thread  = in the API process; for tests/debugging only, a hung run cannot be killed.
RUN_MODE=process
# Per-worker address-space limit in MB (Linux only, 0 = off). Prefer container limits.
WORKER_MEMORY_MB=0
# Offline fake model for smoke tests ("mode": "test" in the run request).
ALLOW_TEST_MODE=true
# Extra host suffixes webfetch must never reach (comma separated). The gateway and
# database hosts are always blocked automatically.
WEB_BLOCKED_HOSTS=
